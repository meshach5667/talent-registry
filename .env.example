PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/talent_registry
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1

# Cloudinary Storage (optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GitHub OAuth App Configuration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/api/v1/auth/github/callback

# Email Service Configuration (Gmail, Resend, Brevo, SendGrid, Amazon SES, or custom SMTP)
# If left empty in development, Ethereal test inbox is automatically used with a live preview link.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Talent Registry" <noreply@talentregistry.africa>

# Alternatively, configure Resend API key directly:
# RESEND_API_KEY=re_xxxxxxxxx
